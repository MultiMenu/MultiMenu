{
  "name": "multimenu",
  "productName": "MultiMenu",
  "version": "3.1.1",
  "description": "Roblox account manager, multi-instance launcher, automation and PC performance toolkit.",
  "main": "src/main/main.js",
  "author": "MultiMenu",
  "license": "MIT",
  "private": true,
  "multimenu": {
    "updateRepo": "MultiMenu/MultiMenu"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test test/*.test.js",
    "i18n:extract": "node scripts/i18n-extract.js",
    "i18n:check": "node scripts/i18n-extract.js --check",
    "icons": "node scripts/make-icons.js",
    "dist": "node scripts/build-streamdeck.js && electron-builder --win nsis zip --x64 --publish never",
    "dist:dir": "node scripts/build-streamdeck.js && electron-builder --win dir --x64 --publish never",
    "checksums": "node scripts/checksums.js dist",
    "streamdeck": "node scripts/build-streamdeck.js",
    "lint": "eslint ."
  },
  "dependencies": {
    "koffi": "2.16.3",
    "nodemailer": "10.5.0",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5",
    "electron": "45.3.0",
    "electron-builder": "26.18.0",
    "eslint": "^9.39.5",
    "globals": "^15.15.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MultiMenu/MultiMenu.git"
  },
  "homepage": "https://github.com/MultiMenu/MultiMenu",
  "bugs": {
    "url": "https://github.com/MultiMenu/MultiMenu/issues"
  }
}
